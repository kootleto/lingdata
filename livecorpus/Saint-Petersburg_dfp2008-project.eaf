    <TIER ANNOTATOR="kootleto" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@dfp2008m" PARTICIPANT="@dfp2008m" TIER_ID="gestComment@dfp2008m">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425"
                TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts55">
                <ANNOTATION_VALUE>указывает на какой-то описываемый объект</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2004"
                TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts97">
                <ANNOTATION_VALUE>я настаиваю на том, что это один жест: по сути, это смена позы (ровно -&gt; нога на ногу), и движения всех других органов связаны с этой сменой позы, поэтому тип и значение у жеста едины. Просто не все органы задействованы одновременно</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428"
                TIME_SLOT_REF1="ts151" TIME_SLOT_REF2="ts159">
                <ANNOTATION_VALUE>я имею в виду здесь наклон головы, переходящий потом в нечто вроде кивков</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1634"
                TIME_SLOT_REF1="ts348" TIME_SLOT_REF2="ts356">
                <ANNOTATION_VALUE>полностью накладывается на предыдущий, начало условно</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2007"
                TIME_SLOT_REF1="ts551" TIME_SLOT_REF2="ts574">
                <ANNOTATION_VALUE>см. 17:21-17:22 - такая же смена позы</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1704"
                TIME_SLOT_REF1="ts698" TIME_SLOT_REF2="ts719">
                <ANNOTATION_VALUE>в отличие от жеста 17:21-17:22, здесь достаточно легко поделить смену позы на два жеста</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1758"
                TIME_SLOT_REF1="ts934" TIME_SLOT_REF2="ts947">
                <ANNOTATION_VALUE>чуть-чуть накладывается на предыдущий</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1770"
                TIME_SLOT_REF1="ts979" TIME_SLOT_REF2="ts985">
                <ANNOTATION_VALUE>это как бы первая половинка противопоставления. Было бы логично, чтобы руки потом пошли в другую сторону, но, хотя они остались слева, мне кажется, можно посчитать это началом противопоставления</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1843"
                TIME_SLOT_REF1="ts1008" TIME_SLOT_REF2="ts1016">
                <ANNOTATION_VALUE>хотя это по смыслу пара к противопоставительному жесту, этот мне кажется скорее подчеркивающим</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1784"
                TIME_SLOT_REF1="ts1039" TIME_SLOT_REF2="ts1042">
                <ANNOTATION_VALUE>подчеркивание встроенного отрицания - не останавливаться</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1804"
                TIME_SLOT_REF1="ts1081" TIME_SLOT_REF2="ts1091">
                <ANNOTATION_VALUE>здесь уже точно чистое противопоставление. Правда, можно посчитать этот жест и изобразительным из-за его иконичности, но мне кажется, что он прагматический, потому что он обозначает структуру высказывания</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1819"
                TIME_SLOT_REF1="ts1110" TIME_SLOT_REF2="ts1115">
                <ANNOTATION_VALUE>левой рукой прагматический, а правой адаптор одновременно</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1820"
                TIME_SLOT_REF1="ts1148" TIME_SLOT_REF2="ts1157">
                <ANNOTATION_VALUE>мне надоело везде писать "подчеркнуть эмфазу" и показалось, что здесь конкретное значение: я как бы обрисовываю вероятные сценарии, при которых надо корректировать</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2003"
                TIME_SLOT_REF1="ts1195" TIME_SLOT_REF2="ts1210">
                <ANNOTATION_VALUE>есть и что-то изобразительное: как и в случае с набором вариантов, я руками обозначаю "всё"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1862"
                TIME_SLOT_REF1="ts1209" TIME_SLOT_REF2="ts1217">
                <ANNOTATION_VALUE>левая рука. Это странное значение, но мне кажется, что протянутая вперед ладонь обозначает именно пример, как бы показывая что-то</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1935"
                TIME_SLOT_REF1="ts1462" TIME_SLOT_REF2="ts1475">
                <ANNOTATION_VALUE>более-менее (похоже на противопоставление: тоже движение туда-сюда)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1998"
                TIME_SLOT_REF1="ts1641" TIME_SLOT_REF2="ts1653">
                <ANNOTATION_VALUE>похоже на разведение руками. Не уверен, что это эмблема, но вроде это очень устойчивый жест</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
